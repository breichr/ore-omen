# Serves the static PWA and proxies /api to the API container (same origin,
# so the session cookie needs no CORS). TLS is terminated by Coolify.
:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Service worker and manifest must never be cached long
		@nocache path /service-worker.js /manifest.webmanifest /index.html /
		header @nocache Cache-Control "no-cache"
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
